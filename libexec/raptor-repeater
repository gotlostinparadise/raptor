#!/usr/bin/env python3
"""Burp-repeater analog — send/tamper a request, generate runnable PoCs.

Two modes:
  --poc {curl,python,http}   generate a runnable PoC from a request spec (offline)
  --send --active            send the request (requires --active + --authorization)

Tamper before sending/encoding with --set-param NAME=VALUE / --set-header NAME=VALUE.

Usage:
  raptor-repeater --spec req.json --poc curl
  raptor-repeater --spec req.json --poc python --out poc.py
  raptor-repeater --spec req.json --set-param id=2 --send --active --authorization Y

Request spec JSON: {"method": "...", "url": "...", "headers": {...}, "body": "..."}
Exit codes: 0 ok, 2 usage / gate error.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from core.repeater.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
