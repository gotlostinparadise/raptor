#!/usr/bin/env python3
"""Build the application-layer request/traffic graph into a run directory.

The app-layer twin of the recon graph: origins, pages, forms, endpoints (as
templated method+path nodes), their parameters, the identities traffic was sent
as, and the vulnerabilities found — captured request/response riding on the
graph as evidence. Crawl, API-spec import, and proxy capture all feed one
``(type, id)`` merge graph.

Today's offline surface is API-spec import (``--spec``); active crawl/browser/
proxy sources register automatically and run under a non-passive profile as they
land. ``--rebuild`` re-derives the exports from persisted records only.

Usage:
  raptor-webgraph --out-dir <dir> --spec openapi.yaml --base-url https://api.x
  raptor-webgraph --out-dir <dir> --origins https://app.x --profile safe
  raptor-webgraph --out-dir <dir> --rebuild

Output (under --out-dir):
  normalized/<kind>.jsonl   one record per line, schema in core/webgraph/model.py
  graph/web.{json,dot,graphml}
  webgraph-summary.json

Profiles: passive (no traffic to target) | safe (throttled) | aggressive.
Exit codes: 0 ok, 2 usage error.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from core.webgraph.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
