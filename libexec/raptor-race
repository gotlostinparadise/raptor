#!/usr/bin/env python3
"""Business-logic / race-condition testing via concurrent replay.

Fires N identical requests simultaneously (a single-packet-attack approximation)
and applies a state oracle: if a limited operation (single-use coupon, one
withdrawal, a stock decrement) succeeds MORE times than the operator says it
should, the limit is not atomic — a confirmed TOCTOU race (PROOF_STATE_ORACLE).

SAFE BY DEFAULT: no request is sent unless --active AND the config declares a
non-empty `authorization`. Concurrency is hard-capped (config `max_concurrency`).

Usage:
  raptor-race --out-dir <dir> --config race.json               (dry-run plan)
  raptor-race --out-dir <dir> --config race.json --active      (fires concurrent requests)

Exit codes: 0 ok, 2 usage / gate error.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from core.racecond.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
